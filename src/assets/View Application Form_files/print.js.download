function Clickheretoprint1() {
    var disp_setting = "toolbar=yes,location=no,directories=yes,menubar=yes,";
    disp_setting += "scrollbars=yes,width=900, height=700, left=10, top=10";
    var content_vlue = document.getElementById("print_content1").innerHTML;

    var docprint = window.open("", "", disp_setting);
    docprint.document.open();
    //   docprint.document.write('<html><head><title> UPPRPB Lucknow </title>');
    docprint.document.write('<link href="css/print.css" rel="stylesheet" type="text/css" />')
    docprint.document.write('</head><body onLoad="self.print()" ><center>');
    docprint.document.write(content_vlue);
    docprint.document.write('</center></body></html>');
    docprint.document.close();
    docprint.focus();


}

function PrintContent111() {
    printWindow = window.open("", "mywindow", "location=0,status=0,scrollbars=1,resizable=1");

    var strContent = "<html><head>";
    strContent = strContent + "<title" + ">Print Preview</title>";
    strContent = strContent + "<link href='css/print.css' type='text/css' rel='stylesheet' />";
    strContent = strContent + "</head><body onLoad='self.print()'>";
    
    strContent = strContent + "<div style='width:100%;'>";

    var newsDiv = document.createElement('div');
    newsDiv.innerHTML = document.getElementById('mainprint').innerHTML;
    for (var i = 0; i < newsDiv.childNodes.length; i++) {
        if (newsDiv.childNodes[i].id == 'maindiv')
            newsDiv.childNodes[i].className = "Invisible"; //newsDiv.removeChild(newsDiv.childNodes[i]);
    }

    strContent = strContent + newsDiv.innerHTML;
    strContent = strContent + "</div>";
    strContent = strContent + "</body>";
    printWindow.document.write(strContent);
    printWindow.document.close();
    printWindow.focus();
}

function PrintContent() {
