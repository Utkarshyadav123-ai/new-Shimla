$(document).ready(function () {
    // Error Model Message
    $('#Error_close').click(function () {
        $('#ErrorBox').css("right", "-420px");
    });

    $('.show_date_function').datepicker({
        autoclose: true,
        format: 'dd/mm/yyyy'
    });

    $('.show_date_function_EQ').datepicker({
        format: 'dd/mm/yyyy',
        useCurrent: false,
        constrainInput: false
    })
    //Listen for the change even on the input
    .change(dateChanged)
    .on('changeDate', dateChanged);


    $('.date_show_function').datepicker({
        autoclose: true,
        format: 'dd/mm/yyyy'
    });

    //Initialize Select2 Elements
    if ($('.select2').length) {
        $('.select2').select2();
    }

    $(".fa-exclamation-triangle.Error_Icon").hover(function () {
        var control_tooltip = "";
        var Err_Validate_Control = "";
        Err_Validate_Control = $(this).parent('span').attr('data-val-controltovalidate');
        control_tooltip = $('#' + Err_Validate_Control).attr('title');
        $(this).attr('title', control_tooltip);
    });

    // Initialize InputMask
    if ($("#ctl00_MainContent_txt_Otp").length > 0) {
        $("#ctl00_MainContent_txt_Otp").inputmask({
            mask: "999999",
            placeholder: "XXXXXX"
        });
    }

});

$(function () {
    $('[data-toggle="tooltip"]').tooltip();
});

function ShowErrorBox(msg) {
    $('.ErrorMsg').html(msg);
    $('.popup').show().css("right", "20px");
    return false;
}

function RefreshCaptcha(data_id) {
    var Current_url = window.location.href;
    var img = document.getElementById(data_id);
    img.src = getCookie('Base_url') + "Captcha.ashx?query=" + Math.random();
    var txtbx = document.getElementById("<%=txtInput.ClientID%>");
    $(txtbx).val("");
}

function getCookie(Name) {
    var re = new RegExp(Name + "=[^;]+", "i"); //construct RE to search for target name/value pair
    if (document.cookie.match(re)) //if cookie found
        return document.cookie.match(re)[0].split("=")[1] //return its value
    return null
}

function dateChanged(ev) {
    debugger;
    // Accepts xyz as the value
    if ($(this).val() == "NA")
        return true;
    // Accepts just valid dates as the value
    var comp = $(this).val().split('/');
    var m = parseInt(comp[0], 10);
    var d = parseInt(comp[1], 10);
    var y = parseInt(comp[2], 10);
    var date = new Date(y, m - 1, d);
    if (date.getFullYear() == y && date.getMonth() + 1 == m && date.getDate() == d)
        return true;
    $(this).datepicker('hide');
    console.log("asdasdasdsa");
}

